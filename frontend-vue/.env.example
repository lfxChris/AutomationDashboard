# Frontend build-time env vars. Vite exposes any var prefixed VITE_ to the browser.
# Copy to .env for local dev (it's gitignored). For production, the GitHub Actions
# workflow injects the deployed backend URL.

# Local dev backend (the fallback in App.vue is the same, so this is optional locally)
VITE_API_URL=http://127.0.0.1:8000
