# Copy this file to backend/.env and fill in real values for local dev.
# .env is gitignored; .env.example is the safe-to-commit template.

# Your healthchecks.io read-only API key (starts with hcr_)
HC_API_KEY=

# Comma-separated list of origins allowed to call this API.
# For local dev the defaults work; for production set the GitHub Pages URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
